#! /usr/bin/bash

set -e

export GIT_TERMINAL_PROMPT=0

pushd "$ARENA_DIR" > /dev/null
trap 'popd > /dev/null' EXIT

_PYTHON=${PYTHON:-1}
_GIT=${GIT:-1}
_ROSDEP=${ROSDEP:-1}

export ROSDEP_EXCLUDES='libignition-gazebo6-dev gazebo_dev gazebo_ros gazebo_plugins gazebo_ros2_control flir_ptu_description'



sudo apt update

# update vcstool
echo updating vcstool...
python -m pip install git+https://github.com/voshch/vcstool.git || echo 'failed vcstool upgrade, ignoring'

#update repos
if [ $_GIT -eq 1 ] ; then
    echo updating Arena...
    git pull --ff-only --autostash

    # init core SDKs; per-robot/planner pieces stay opt-in (no --recursive)
    git submodule update --init --checkout arena_planners arena_robots humansim \
        || echo "failed to init/update arena_planners/arena_robots/humansim, ignoring"

    # attach rebase-mode submodules to their .gitmodules branch (init leaves them detached)
    # shellcheck disable=SC2016
    git submodule foreach --recursive '
        update=$(git config -f "$toplevel/.gitmodules" "submodule.$name.update" 2>/dev/null || true)
        branch=$(git config -f "$toplevel/.gitmodules" "submodule.$name.branch" 2>/dev/null || true)
        if [ "$update" = rebase ] && [ -n "$branch" ] && [ "$(git rev-parse --abbrev-ref HEAD)" != "$branch" ]; then
            git switch "$branch" 2>/dev/null \
                || git switch --track -c "$branch" "origin/$branch" 2>/dev/null \
                || echo "  $name: branch $branch unavailable, staying detached"
        fi
    ' || echo "submodule branch attach had issues, ignoring"

    # rebase attached branches onto the metarepo-pinned commit (autostash guards dirty submodules)
    git -c rebase.autoStash=true submodule update --rebase --recursive \
        || echo "submodule rebase update had issues, resolve manually"

    # re-source
    . "$ARENA_DIR/_meta/tools/source"

    vcs import --input "$ARENA_DIR/_meta/repos/arena.repos" --recursive --ff --add-existing "$ARENA_WS_DIR/src"\
        || echo "failed to pull all arena repos, ignoring"

    arena registry list | while read -r name; do
        arena registry resolve "$name" >/dev/null 2>&1 || continue
        arena registry pull "$name"
        (arena feature "$name" update || echo "failed to update feature $name, ignoring")
    done
fi

if [ $_ROSDEP -eq 1 ] ; then
    # shellcheck disable=SC2016
    rosdep update --rosdistro "$ARENA_ROS_DISTRO" \
        && arena deps \
    || echo "rosdep failed to install all dependencies"
fi

if [ $_PYTHON -eq 1 ] ; then
    echo updating python deps...
    uv sync --inexact --active
fi

# update links
echo 'Updating links...'
"$ARENA_DIR/_meta/tools/create_links"

echo -e '\033[0;31m'
echo "don't forget to rebuild!"
echo -e '\033[0m'

trap - EXIT
popd > /dev/null

unset GIT_TERMINAL_PROMPT