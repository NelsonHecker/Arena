#!/usr/bin/env bash

set -e

python_bin=${1:-"$ARENA_DIR/.venv/bin/python"}

if [ ! -x "$python_bin" ]; then
    echo "python executable not found: $python_bin"
    exit 1
fi

torch_version=$(
    "$python_bin" - <<'PY'
import importlib.metadata as md

version = md.version("torch")
print(version.split("+", 1)[0])
PY
)

if [ -z "$torch_version" ]; then
    echo "failed to determine installed torch version"
    exit 1
fi

echo "installing torch companion packages compatible with torch==$torch_version..."
uv pip install --python "$python_bin" \
    "torch==$torch_version" \
    "torchvision" \
    "torchaudio"