#!/usr/bin/env bash

if [ -n "$ZSH_VERSION" ]; then
    shell='zsh'
    # shellcheck disable=SC2296
    THIS_FILE="${(%):-%N}"
    unsetopt PUSHD_IGNORE_DUPS
else
    shell='bash'
    THIS_FILE="${BASH_SOURCE[0]}"
fi
SOURCE_FILE=$(realpath "$THIS_FILE")
export SOURCE_FILE
export shell

# increase ulimit to fit pythonpath
current_stack=$(ulimit -s)
if [ "$current_stack" != "unlimited" ] && [ "$current_stack" -lt 65536 ]; then
    ulimit -s 65536 2>/dev/null || {
        echo "Warning: Could not increase stack limit to 65536KB (current: ${current_stack}KB)" >&2
        echo "Consider running: echo '* soft stack 65536' | sudo tee -a /etc/security/limits.conf" >&2
    }
fi
unset current_stack

ARENA_WS_DIR="${ARENA_WS_DIR:-$(pwd)}"

export ARENA_WS_DIR
export ARENA_DIR="$ARENA_WS_DIR/src/Arena"
export ARENA_FEATURES_DIR="${ARENA_FEATURES_DIR:-$ARENA_DIR/_meta/features}"

export INSTALLED="$ARENA_DIR/.installed"
export TOOLS_DIR="$ARENA_DIR/_meta/tools"
export ARENA_ASSETS_DIR="$ARENA_DIR/_assets/"
export ARENA_ASSETS_DIR_LOCAL="$ARENA_ASSETS_DIR/_local"
export ARENA_VENV_DIR="${ARENA_VENV_DIR:-$ARENA_DIR/.venv}"

export ARENA_ROS_DISTRO="${ARENA_ROS_DISTRO:-jazzy}"

export FASTRTPS_DEFAULT_PROFILES_FILE=${FASTRTPS_DEFAULT_PROFILES_FILE:-~/.ros/fastdds.xml}
export ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-1}
export RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/opt/ros/${ARENA_ROS_DISTRO}/lib/"
export ASSET_BUCKETS=${ARENA_ASSET_BUCKETS:-"default"}

_feature_registry(){
    local verb="$1"
    local name="$2"
    case "$verb" in
        has)
            grep -qx -- "$name" "$INSTALLED" 2>/dev/null
            return $?
        ;;
        add)
            if ! _feature_registry has "$name"; then
                echo "$name" >> "$INSTALLED"
            fi
            return 0
        ;;
        remove)
            [ -f "$INSTALLED" ] || return 0
            local escaped
            escaped=$(printf '%s\n' "$name" | sed 's/[][\.*^$/]/\\&/g')
            sed -i "/^${escaped}\$/d" "$INSTALLED"
            return $?
        ;;
        list)
            cat "$INSTALLED" 2>/dev/null
            return 0
        ;;
        pull)
            local repos_file="$ARENA_DIR/_meta/repos/${name}.repos"
            [ -f "$repos_file" ] || return 0
            vcs import --input "$repos_file" --shallow --recursive --ff \
                --add-existing "$ARENA_WS_DIR/src" \
                || echo "failed to pull all $name repos, ignoring" >&2
            return 0
        ;;
        resolve)
            if [ -f "$ARENA_FEATURES_DIR/${name}" ] ; then
                echo "$ARENA_FEATURES_DIR/${name}"
            elif [ -d "$ARENA_FEATURES_DIR/${name}" ] && [ -f "$ARENA_FEATURES_DIR/${name}/main" ] ; then
                echo "$ARENA_FEATURES_DIR/${name}/main"
            else
                return 1
            fi
            return 0
        ;;
        *)
            echo "Usage: _feature_registry <has|add|remove|list|pull|resolve> [name]" >&2
            return 1
        ;;
    esac
}
export -f _feature_registry 2>/dev/null || true

export ARENA_MODELS_FORMATS="yaml,png,jpg,mdl"

exit(){
    echo "Failed to source $1, skipping" >&2
}
while read -r feature; do
    if feature_path="$(_feature_registry resolve "$feature")"; then
        source "$feature_path" source
    fi
done < <(_feature_registry list)
unset -f exit


if [ -f "/opt/ros/${ARENA_ROS_DISTRO}/setup.${shell}" ] ; then
    . "/opt/ros/${ARENA_ROS_DISTRO}/setup.${shell}"
fi
if [ -f install/local_setup.${shell} ] ; then
    . "install/local_setup.${shell}"
fi
if [ -f "/opt/ros/${ARENA_ROS_DISTRO}/setup.${shell}" ] ; then
    . "/opt/ros/${ARENA_ROS_DISTRO}/setup.${shell}"
fi


if [ -f "$ARENA_WS_DIR/.env" ] ; then
    set -a
    . "$ARENA_WS_DIR/.env"
    set +a
fi

_arena_heal_pip(){
    python -c 'import pip.__main__' 2>/dev/null || python -m ensurepip --upgrade >/dev/null
}
export -f _arena_heal_pip 2>/dev/null || true

if [ -z ${ARENA_SOURCED+x} ] ; then

    PS1_BACKUP=$PS1

    # stop rviz from flashing
    export QT_SCREEN_SCALE_FACTORS=1
    
    # python env
    pushd "$ARENA_DIR" > /dev/null || return 1
        if [ ! -f "$ARENA_VENV_DIR/.installed" ]; then
            uv venv "$ARENA_VENV_DIR" --allow-existing --system-site-packages && \
            UV_PROJECT_ENVIRONMENT="$ARENA_VENV_DIR" uv sync --inexact --project . && \
            touch "$ARENA_VENV_DIR/.installed"
        fi

        # if [ "$venv_path" != "$VIRTUAL_ENV" ] ; then
        . "$ARENA_VENV_DIR/bin/activate"
        dirs=("$ARENA_VENV_DIR"/lib/*/site-packages)
        _IFS=$IFS IFS=':'
        export PYTHONPATH="${dirs[*]}:$PYTHONPATH"
        IFS=$_IFS
        unset _IFS
        unset dirs
        unset venv_path
    popd > /dev/null || return 1
    
    
    r2st(){ ros2 service call "$1" "$(ros2 service type "$1")";}
    
    arena(){
        local verb="$1"
        if [ -n "$verb" ] ; then
            shift
        fi

        pushd "$ARENA_WS_DIR" > /dev/null || return $?
        trap 'popd > /dev/null' EXIT
        
        case "$verb" in
            build)
                "${TOOLS_DIR}/colcon_build" "$@"
                . "$SOURCE_FILE"
                result=$?
            ;;
            rebuild)
                if [ $# -lt 1 ]; then
                    echo "Usage: arena rebuild <colcon-selection-args|package names>" >&2
                    echo "  e.g. arena rebuild foo bar" >&2
                    echo "       arena rebuild --packages-select foo bar" >&2
                    echo "       arena rebuild --packages-select-regex 'arena_.*'" >&2
                    result=1
                else
                    if [[ "$1" != --* ]]; then
                        set -- --packages-select "$@"
                    fi
                    mapfile -t _REBUILD_PKGS < <(colcon list --names-only --base-paths "$ARENA_WS_DIR/src" "$@")
                    if [ ${#_REBUILD_PKGS[@]} -eq 0 ]; then
                        echo "arena rebuild: no packages matched" >&2
                        result=1
                    else
                        echo "arena rebuild: resolved ${#_REBUILD_PKGS[@]} package(s): ${_REBUILD_PKGS[*]}"
                        for pkg in "${_REBUILD_PKGS[@]}"; do
                            if [ -d "build/${pkg}" ] || [ -d "install/${pkg}" ]; then
                                echo "  rm -rf build/${pkg} install/${pkg}"
                            fi
                            rm -rf "build/${pkg}" "install/${pkg}"
                        done
                        echo "arena rebuild: clean done, invoking arena build"
                        arena build "$@"
                        result=$?
                    fi
                    unset _REBUILD_PKGS
                fi
            ;;
            deps)
                rosdep install --ignore-src -r -y --rosdistro "${ARENA_ROS_DISTRO}" --from-paths src "$@"
                result=$?
            ;;
            update)
                "${TOOLS_DIR}/pull" "$@"
                result=$?
                _arena_heal_pip
            ;;
            launch)
		        killall -s 9 task_generator_node 2>/dev/null && sleep 1
                ros2 launch arena_bringup arena.launch.py "$@"
                result=$?
            ;;
            test)
                if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
                    set -- --packages-select "$@"
                fi
                if ! printf '%s\n' "$@" | grep -qE -- '^--packages-(select|select-regex|up-to|above|ignore)'; then
                    set -- --packages-select-regex '^arena_' '^task_generator$' "$@"
                fi
                mapfile -t _TEST_PKGS < <(colcon list --names-only --base-paths "$ARENA_WS_DIR/src" "$@" 2>/dev/null)
                colcon test --event-handlers console_direct+ "$@"
                local _test_rc=$?
                if [ ${#_TEST_PKGS[@]} -gt 0 ]; then
                    "${TOOLS_DIR}/test_summary" "$ARENA_WS_DIR/build" --packages "${_TEST_PKGS[@]}"
                else
                    "${TOOLS_DIR}/test_summary" "$ARENA_WS_DIR/build"
                fi
                local _result_rc=$?
                if [ $_test_rc -ne 0 ]; then
                    result=$_test_rc
                else
                    result=$_result_rc
                fi
                unset _test_rc _result_rc _TEST_PKGS
            ;;
            deactivate)
                deactivate 2>/dev/null || true
                export PS1=$PS1_BACKUP
                unset PS1_BACKUP
                unset ARENA_SOURCED
                unset -f arena
                result=0
            ;;
            feature)
                features=""
                for entry in "$ARENA_FEATURES_DIR"/*; do
                    [ -e "$entry" ] || continue
                    fname=$(basename "$entry")
                    _feature_registry resolve "$fname" >/dev/null 2>&1 || continue
                    marker=""
                    if _feature_registry has "$fname"; then
                        marker="*"
                    fi
                    features="${features:+$features }${fname}${marker}"
                done
                unset entry fname marker
                if [ $# -lt 1 ]; then
                    echo "Usage: arena feature <name> <install|uninstall|update|...>" >&2
                    echo "Available features: $features" >&2
                    result=1
                elif feature_path="$(_feature_registry resolve "$1")"; then
                    fname="$1"
                    shift
                    fverb="$1"
                    case "$fverb" in
                        install)
                            if _feature_registry has "$fname"; then
                                echo "$fname is already installed."
                                result=0
                            else
                                _feature_registry pull "$fname"
                                if ($SHELL -c "source '$SOURCE_FILE' > /dev/null 2>&1 && $shell '$feature_path' update"); then
                                    _feature_registry add "$fname"
                                    echo "Installed $fname successfully."
                                    result=0
                                else
                                    echo "Install of $fname failed during update." >&2
                                    result=1
                                fi
                            fi
                        ;;
                        update)
                            if ! _feature_registry has "$fname"; then
                                echo "$fname is not installed; run 'arena feature $fname install' first." >&2
                                result=1
                            else
                                shift
                                ($SHELL -c "source '$SOURCE_FILE' > /dev/null 2>&1 && $shell '$feature_path' update $*")
                                result=$?
                            fi
                        ;;
                        uninstall)
                            shift
                            # shellcheck disable=SC1090
                            source "$feature_path" uninstall "$@"
                            result=$?
                        ;;
                        *)
                            ($SHELL -c "source '$SOURCE_FILE' > /dev/null 2>&1 && $shell '$feature_path' $*")
                            result=$?
                        ;;
                    esac
                    unset fname fverb
                else
                    echo "Unknown feature '$1'" >&2
                    echo "Available features: $features" >&2
                    result=1
                fi
            ;;
            registry)
                _feature_registry "$@"
                result=$?
            ;;
            resource)
                arena deactivate
                source "$SOURCE_FILE"
                return $?
            ;;
            *)
                echo 'Usage: arena <build|rebuild|deps|update|launch|test|deactivate|feature|registry|resource> [args...]' >&2
                result=1
            ;;
        esac

        trap - EXIT
        popd > /dev/null || return $?
        
        return $result
    }
    
    export -f arena 2>/dev/null || true


    export ARENA_SOURCED=1
    export PS1_BACKUP
    export PS1="(Arena) $PS1_BACKUP"
    export PROMPT="(Arena) $PROMPT"
    echo 'sourced Arena environment'
fi

_arena_heal_pip