#!/usr/bin/env bash

name="robots"
_py="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/robots.py"

# === MAIN SCRIPT ===
help(){
    echo "Usage: $name <update|uninstall|source|add|rm|ls|check>"
    echo ""
    echo "Per-robot submodule management (mesh assets + upstream deps)."
    echo "  add <name...>     clone robot's submodules"
    echo "  rm <name...>      deinit robot's submodules"
    echo "  ls                list robots — [x] ready, [ ] pending"
    echo "  check [--all]     verify all package://arena_robots/... URIs resolve"
    echo "  update            refresh initialized robot submodules"
    echo "  uninstall         deinit all robot submodules"
}
if [ $# -lt 1 ]; then
    help
    exit 1
fi
case "$1" in
    update|add|rm|ls|check)
        python3 "$_py" "$@"
        exit $?
    ;;
    uninstall)
        python3 "$_py" uninstall
        arena registry remove "$name"
        # shellcheck disable=SC2317
        return $? 2>/dev/null || exit $?
    ;;
    source)
        return 0
    ;;
    *)
        help
        exit 1
    ;;
esac
