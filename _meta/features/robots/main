#!/usr/bin/env bash

name="robots"
_py="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/robots.py"

# === MAIN SCRIPT ===
help(){
    echo "Usage: $name <update|install|uninstall|source|add|rm|ls|check|drive>"
    echo ""
    echo "Per-robot/component submodule management (mesh assets + upstream deps)."
    echo "  add <name...>     clone robot/component (<type>/<name>) submodules (alias: install)"
    echo "  rm <name...|--all>  deinit robot/component submodules (alias: uninstall <name...>)"
    echo "  ls                list robots and components, [x] ready, [ ] pending"
    echo "  check [--all]     verify all package://arena_robots/... URIs resolve"
    echo "  update            refresh initialized robot submodules"
    echo "  uninstall         deinit all robot submodules"
    echo "  drive [opts]      run a random-goal episode per ready robot, report success/total"
}
if [ $# -lt 1 ]; then
    help
    exit 1
fi
case "$1" in
    add|update)
        python3 "$_py" "$@" || exit $?
        arena deps && arena build
        exit $?
    ;;
    install)
        shift
        python3 "$_py" add "$@" || exit $?
        arena deps && arena build
        exit $?
    ;;
    rm|ls|check|drive)
        python3 "$_py" "$@"
        exit $?
    ;;
    uninstall)
        shift
        if [ $# -gt 0 ]; then
            python3 "$_py" rm "$@"
            # shellcheck disable=SC2317
            return $? 2>/dev/null || exit $?
        fi
        python3 "$_py" uninstall
        arena registry remove "$name"
        # shellcheck disable=SC2317
        return $? 2>/dev/null || exit $?
    ;;
    source)
        return 0
    ;;
    *)
        help
        exit 1
    ;;
esac
