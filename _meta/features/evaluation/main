#!/usr/bin/env bash

name="evaluation"

update(){
    set -e
    cd "$ARENA_DIR"
    git submodule update --init --rebase --depth 1 arena_evaluation
    cd "$ARENA_WS_DIR"
    arena build
}

uninstall(){
    pushd "$ARENA_DIR" > /dev/null || return 1
        git submodule deinit -f arena_evaluation
    popd > /dev/null || return 1
    arena registry remove "$name"
}

# === MAIN SCRIPT ===
help(){
    echo "Usage: $name <update|uninstall|source|launch|list|status|tail>"
    echo ""
    echo "arena_evaluation for recording, metrics, and benchmarking."
    echo "This enables:"
    echo "  update    -- pull arena_evaluation submodule and rebuild"
    echo "  uninstall -- deinit arena_evaluation and remove from registry"
    echo "  source    -- no-op; sourced by the feature dispatcher"
    echo "  launch    -- run a benchmark (ros2 run arena_evaluation benchmark)"
    echo "  list      -- list available evaluations"
    echo "  status    -- show status of a running or completed evaluation"
    echo "  tail      -- stream live output of a running evaluation"
}
if [ $# -lt 1 ]; then
    help
    exit 1
fi
case "$1" in
    update)
        update
        exit $?
    ;;
    uninstall)
        uninstall
        # shellcheck disable=SC2317
        return $? 2>/dev/null || exit $?
    ;;
    source)
        return 0
    ;;
    launch)
        _feature_registry require "$name" || exit 1
        shift
        ros2 run arena_evaluation benchmark "$@"
        exit $?
    ;;
    list)
        _feature_registry require "$name" || exit 1
        shift
        ros2 run arena_evaluation evaluation_cli list "$@"
        exit $?
    ;;
    status)
        _feature_registry require "$name" || exit 1
        shift
        ros2 run arena_evaluation evaluation_cli status "$@"
        exit $?
    ;;
    tail)
        _feature_registry require "$name" || exit 1
        shift
        ros2 run arena_evaluation evaluation_cli tail "$@"
        exit $?
    ;;
    *)
        help
        exit 1
    ;;
esac
