#!/usr/bin/env bash

name="evaluation"

update(){
    set -e
    cd "$ARENA_DIR"
    git submodule update --init --rebase --depth 1 arena_evaluation
    cd "$ARENA_WS_DIR"
    arena build
}

uninstall(){
    pushd "$ARENA_DIR" > /dev/null || return 1
        git submodule deinit -f arena_evaluation
    popd > /dev/null || return 1
    arena registry remove "$name"
}

# === MAIN SCRIPT ===
help(){
    echo "Usage: $name <install|update|uninstall|source|benchmark|list|status|tail|ps|console|extract|run|process|report|plot|acoustic>"
    echo ""
    echo "arena_evaluation for recording, metrics, and benchmarking."
    echo "This enables:"
    echo "  install   -- register feature, pull arena_evaluation submodule and rebuild"
    echo "  update    -- pull arena_evaluation submodule and rebuild"
    echo "  uninstall -- deinit arena_evaluation and remove from registry"
    echo "  source    -- no-op; sourced by the feature dispatcher"
    echo "  benchmark -- run a benchmark suite (ros2 run arena_evaluation benchmark)"
    echo "  list      -- list available evaluations"
    echo "  status    -- show status of a running or completed evaluation"
    echo "  tail      -- stream live output of a running evaluation"
    echo "  ps        -- list running arena processes (benchmark runner, sim, nodes)"
    echo "  console   -- tail a benchmark run's console log (MCP-launched runs only)"
    echo "  extract   -- extract MCAP topics into the Parquet cache"
    echo "  run       -- process recording and generate HTML report"
    echo "  process   -- process recording to generate metrics.parquet"
    echo "  report    -- generate HTML report from processed metrics"
    echo "  plot      -- generate static PNG plots from processed metrics"
    echo "  acoustic  -- acoustic field visualization (list, animate, snapshot)"
}
if [ $# -lt 1 ]; then
    help
    exit 1
fi
case "$1" in
    install)
        _feature_default_install "$name"
        exit $?
    ;;
    update)
        update
        exit $?
    ;;
    uninstall)
        uninstall
        # shellcheck disable=SC2317
        return $? 2>/dev/null || exit $?
    ;;
    source)
        return 0
    ;;
    benchmark)
        _feature_registry require "$name" || exit 1
        shift
        ros2 run arena_evaluation benchmark "$@"
        exit $?
    ;;
    list)
        _feature_registry require "$name" || exit 1
        shift
        ros2 run arena_evaluation evaluation_cli list "$@"
        exit $?
    ;;
    status)
        _feature_registry require "$name" || exit 1
        shift
        ros2 run arena_evaluation evaluation_cli status "$@"
        exit $?
    ;;
    tail)
        _feature_registry require "$name" || exit 1
        shift
        ros2 run arena_evaluation evaluation_cli tail "$@"
        exit $?
    ;;
    ps)
        _feature_registry require "$name" || exit 1
        shift
        ros2 run arena_evaluation evaluation_cli ps "$@"
        exit $?
    ;;
    console)
        _feature_registry require "$name" || exit 1
        shift
        ros2 run arena_evaluation evaluation_cli console "$@"
        exit $?
    ;;
    extract|run|process|report|plot|acoustic)
        _feature_registry require "$name" || exit 1
        ros2 run arena_evaluation evaluation "$@"
        exit $?
    ;;
    *)
        help
        exit 1
    ;;
esac
