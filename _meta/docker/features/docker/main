#!/usr/bin/env bash


docker_build(){
    arena_docker_compose \
        build \
        arena
}

docker_commit(){
    CONTAINER_ID=$(arena_docker_compose \
        ps -q -a arena \
        | tail -n 1)
    echo "committing container $CONTAINER_ID to image $ARENA_IMAGE..."
    sudo env ${docker_env[*]} docker commit --no-pause "$CONTAINER_ID" "$ARENA_IMAGE"
    echo "done"
}

# === MAIN SCRIPT ===
help(){
    echo "Usage: arena feature docker <build|commit|stop|down|compose>"
}

if [ $# -lt 1 ]; then
    help
    exit 1
fi
case "$1" in
    build)
        docker_build
        exit $?
    ;;
    update)
        exit 0
    ;;
    commit)
        docker_commit
        exit $?
    ;;
    stop)
        echo "Stopping containers..."
        arena_docker_compose stop --timeout 0
        exit $?
        ;;
    down)
        echo "Stopping and removing containers..."
        sudo docker run --rm \
            -v /var/run/docker.sock:/var/run/docker.sock \
            docker:cli \
            sh -lc "docker compose --project-name '$ARENA_PROJECT_NAME' down --timeout 0" \
        exit 0
    ;;
    compose)
        shift
        arena_docker_compose "$@"
        exit $?
    ;;
    *)
        help
        exit 1
    ;;
esac
