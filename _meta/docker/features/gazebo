#!/usr/bin/env bash


name="gazebo"

update(){
    return 0
}

uninstall(){
    arena registry remove "$name"
    arena resource
}

source_fn(){
    if [[ ! "$ARENA_MODELS_FORMATS" =~ sdf ]]; then
        export ARENA_MODELS_FORMATS="${ARENA_MODELS_FORMATS},sdf"
    fi
}


help(){
    echo "Usage: $name <install|update|uninstall|source|launch>"
}

case "$1" in
    install)
        _feature_default_install "$name"
        exit $?
    ;;
    update)
        update
        exit $?
    ;;
    uninstall)
        uninstall
        exit $?
    ;;
    source)
        source_fn
        return $?
    ;;
    launch)
        shift
        exec ros2 launch arena_bringup gazebo.launch.py "$@"
    ;;
    *)
        help
        exit 1
    ;;
esac
