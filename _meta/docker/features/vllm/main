#!/usr/bin/env bash

name="vllm"

_config_dir="$ARENA_FEATURES_DIR/vllm"

_load_config(){
    eval "$(python3 - <<EOF
import yaml
with open("$_config_dir/config.yaml") as f:
    cfg = yaml.safe_load(f)
for k, v in cfg.items():
    print(f"export VLLM_{k.upper()}={v!r}")
EOF
)"
}

update(){
    set -e
    _load_config
    arena_docker_compose --profile vllm pull vllm vllm-proxy
    arena_docker_compose --profile vllm create vllm vllm-proxy
    arena_docker_compose --profile vllm up -d --wait vllm vllm-proxy
}

uninstall(){
    _load_config
    arena_docker_compose --profile vllm down --volumes --remove-orphans vllm vllm-proxy
    arena registry remove "$name"
    unset LLM_API_ENDPOINT
}

source_fn(){
    _load_config
    export LLM_API_ENDPOINT="http://localhost:${VLLM_PROXY_PORT}"
    arena_docker_compose --profile vllm up -d --wait vllm vllm-proxy
}

help(){
    echo "Usage: $name <install|update|uninstall|source>"
}

case "$1" in
    update)
        update
        exit $?
    ;;
    uninstall)
        uninstall
        # shellcheck disable=SC2317
        return $? 2>/dev/null || exit $?
    ;;
    source)
        source_fn
        return $?
    ;;
    *)
        help
        exit 1
    ;;
esac
