<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Actor with walk.dae skin. PedSkeletonPlugin sets the world pose via
       TrajectoryPose and scrubs the named clip via AnimationTime from arena_peds. -->
  <actor name="arenian">
    <pose>0 0 0 0 0 0</pose>

    <skin>
      <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>

    <!-- The clip name "walk" is what the plugin passes to AnimationName. -->
    <animation name="walk">
      <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>false</interpolate_x>
    </animation>
  </actor>
</sdf>
