# Programmatically launch a task_generator env owned by arena_node.
string ns                # explicit ns path (e.g. for sim2real); empty = auto-allocate
bool headless            # suppress stdout/stderr for this env's subprocess
string[] launch_args     # passthrough to task_generator.launch.py, "name:=value"
---
bool success
uint16 env_id
string ns
string error_msg
