<?xml version="1.0"?>
<package format="3">
  <name>task_generator_mcp</name>
  <version>0.0.1</version>
  <description>MCP server wrapping task_generator services as Model Context Protocol tools and resources</description>

  <maintainer email="voshch@arena-rosnav.org">voshch</maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rclpy_action</exec_depend>
  <exec_depend>arena_runtime_msgs</exec_depend>
  <exec_depend>task_generator_msgs</exec_depend>
  <exec_depend>task_generator</exec_depend>
  <exec_depend>arena_rclpy_mixins</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
